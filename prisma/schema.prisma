// NutriTrack AI — Prisma schema
// Phase 0-2 models, ported from reference/database_schema.sql. AiFeedback,
// UserStreak, HostelMessItem, ReminderSettings and DataRequest arrive with
// their own phases.
// Note (Supabase Auth decision): identity lives in Supabase's `auth.users`
// table; we store its UUID here instead of a password hash. Prisma only owns
// the `public` schema, so this is a logical reference, not a DB-level FK.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE             @map("male")
  FEMALE           @map("female")
  OTHER            @map("other")
  PREFER_NOT_TO_SAY @map("prefer_not_to_say")

  @@map("gender_enum")
}

enum ActivityLevel {
  SEDENTARY   @map("sedentary")
  LIGHT       @map("light")
  MODERATE    @map("moderate")
  ACTIVE      @map("active")
  VERY_ACTIVE @map("very_active")

  @@map("activity_level_enum")
}

enum Goal {
  WEIGHT_LOSS    @map("weight_loss")
  MUSCLE_GAIN    @map("muscle_gain")
  MAINTENANCE    @map("maintenance")
  GENERAL_HEALTH @map("general_health")

  @@map("goal_enum")
}

enum LivingSituation {
  HOSTEL @map("hostel")
  HOME   @map("home")
  PG     @map("pg")
  OTHER  @map("other")

  @@map("living_situation_enum")
}

enum KitchenAccess {
  FRIDGE_ONLY @map("fridge_only")
  KETTLE      @map("kettle")
  INDUCTION   @map("induction")
  NONE        @map("none")

  @@map("kitchen_access_enum")
}

enum MealType {
  BREAKFAST @map("breakfast")
  LUNCH     @map("lunch")
  DINNER    @map("dinner")
  SNACK     @map("snack")

  @@map("meal_type_enum")
}

enum FoodSource {
  NUTRITIONIX @map("nutritionix")
  USDA        @map("usda")
  CUSTOM_DESI @map("custom_desi")
  MANUAL      @map("manual")

  @@map("food_source_enum")
}

enum ExtractionConfidence {
  HIGH   @map("high")
  MEDIUM @map("medium")
  LOW    @map("low")

  @@map("extraction_confidence_enum")
}

model User {
  id             String    @id @default(uuid())
  supabaseUserId String    @unique @map("supabase_user_id") // UUID from Supabase auth.users
  email          String    @unique
  fullName       String?   @map("full_name")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  lastLoginAt    DateTime? @map("last_login_at")
  isActive       Boolean   @default(true) @map("is_active")

  profile        Profile?
  dailyLogs      DailyLog[]
  hostelMessItems HostelMessItem[]

  @@map("users")
}

/// Saved recurring mess meals, so hostel users can log and get suggestions
/// without retyping the menu every day (spec §3.5).
model HostelMessItem {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mealType MealType @map("meal_type")
  /// 0 = Sunday .. 6 = Saturday. Null means "any day".
  dayOfWeek   Int?   @map("day_of_week")
  description String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("hostel_mess_items")
}

/// Local cache of nutrition lookups plus the custom desi-food dataset.
/// Always consulted before any external API (cost, latency, reliability).
model FoodItem {
  id              String     @id @default(uuid())
  name            String
  normalizedName  String     @map("normalized_name")
  source          FoodSource
  defaultUnit     String     @map("default_unit") // 'piece','bowl','cup','g','ml'
  defaultQuantity Float      @default(1) @map("default_quantity")

  caloriesKcal Float  @map("calories_kcal")
  proteinG     Float  @map("protein_g")
  carbsG       Float  @map("carbs_g")
  fatG         Float  @map("fat_g")
  fiberG       Float? @map("fiber_g")
  /// Used for hostel budget-aware suggestions.
  approxCostPkr Float? @map("approx_cost_pkr")

  createdAt DateTime @default(now()) @map("created_at")

  mealEntries MealEntry[]

  @@unique([normalizedName, defaultUnit])
  @@index([normalizedName])
  @@map("food_items")
}

/// One row per user per day — the aggregation anchor for totals and trends.
model DailyLog {
  id      String   @id @default(uuid())
  userId  String   @map("user_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logDate DateTime @map("log_date") @db.Date

  totalCalories Float @default(0) @map("total_calories")
  totalProteinG Float @default(0) @map("total_protein_g")
  totalCarbsG   Float @default(0) @map("total_carbs_g")
  totalFatG     Float @default(0) @map("total_fat_g")
  totalWaterMl  Int   @default(0) @map("total_water_ml")

  /// Entries are editable same-day only; a closed day is immutable (spec §4).
  isFinalized Boolean @default(false) @map("is_finalized")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mealEntries  MealEntry[]
  waterEntries WaterEntry[]
  aiFeedback   AiFeedback[]

  @@unique([userId, logDate])
  @@index([userId, logDate(sort: Desc)])
  @@map("daily_logs")
}

model MealEntry {
  id         String   @id @default(uuid())
  dailyLogId String   @map("daily_log_id")
  dailyLog   DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  /// Null when nothing matched — never fabricate a food match.
  foodItemId String?   @map("food_item_id")
  foodItem   FoodItem? @relation(fields: [foodItemId], references: [id])

  mealType MealType @map("meal_type")
  /// Resolved food name, shown in the UI. Kept on the entry so a row still
  /// displays correctly when nothing matched (foodItemId is null).
  foodName String @map("food_name")
  /// The full original message, kept for auditing extraction quality.
  rawInputText String @map("raw_input_text")
  quantity     Float
  unit         String

  caloriesKcal Float @map("calories_kcal")
  proteinG     Float @map("protein_g")
  carbsG       Float @map("carbs_g")
  fatG         Float @map("fat_g")

  /// Approximate cost at time of logging, from the food item's reference
  /// price. Snapshotted so the weekly budget view stays stable if prices change.
  estimatedCostPkr Float? @map("estimated_cost_pkr")

  extractionConfidence ExtractionConfidence? @map("extraction_confidence")
  /// True when no nutrition source matched; totals exclude these until resolved.
  needsManualEntry Boolean @default(false) @map("needs_manual_entry")

  loggedAt DateTime @default(now()) @map("logged_at")

  @@index([dailyLogId])
  @@map("meal_entries")
}

/// Generated advice per day, kept for history and the thumbs up/down loop.
model AiFeedback {
  id         String   @id @default(uuid())
  dailyLogId String   @map("daily_log_id")
  dailyLog   DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  feedbackText String @map("feedback_text")
  /// Structured suggestions shown alongside the prose.
  suggestedActions Json? @map("suggested_actions")
  /// 1 = helpful, -1 = not helpful, null = no rating yet.
  userRating Int? @map("user_rating")
  /// True when the safety screen suppressed nutrition advice for this turn.
  flaggedDisorderedEating Boolean @default(false) @map("flagged_disordered_eating")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([dailyLogId])
  @@map("ai_feedback")
}

model WaterEntry {
  id         String   @id @default(uuid())
  dailyLogId String   @map("daily_log_id")
  dailyLog   DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  amountMl Int      @map("amount_ml")
  loggedAt DateTime @default(now()) @map("logged_at")

  @@index([dailyLogId])
  @@map("water_entries")
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  age             Int
  gender          Gender
  heightCm        Float           @map("height_cm")
  weightKg        Float           @map("weight_kg")
  activityLevel   ActivityLevel   @map("activity_level")
  goal            Goal
  livingSituation LivingSituation @map("living_situation")

  // Hostel-specific (nullable; only used when livingSituation = HOSTEL)
  dailyFoodBudgetPkr  Float?         @map("daily_food_budget_pkr")
  hasMessPlan         Boolean?       @map("has_mess_plan")
  messNotes           String?        @map("mess_notes") // what's typically served
  kitchenAccess       KitchenAccess? @map("kitchen_access")
  dietaryRestrictions String[]       @map("dietary_restrictions")

  // Calculated targets — recomputed whenever the profile changes.
  // Derived by src/lib/targets.ts, never entered by hand.
  bmrKcal        Float @map("bmr_kcal")
  tdeeKcal       Float @map("tdee_kcal")
  targetCalories Float @map("target_calories")
  targetProteinG Float @map("target_protein_g")
  targetCarbsG   Float @map("target_carbs_g")
  targetFatG     Float @map("target_fat_g")
  targetWaterMl  Int   @map("target_water_ml")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}
